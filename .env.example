# URL de base de l'API Paylance (sans slash final).
# Si elle est vide, le formulaire de contact utilise une simulation locale.
VITE_API_URL=

# Keycloak (client public, Authorization Code + PKCE S256)
# Exemple de forme : https://auth.example.com  (sans /realms/...)
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# Parcours d'inscription : « true » = données fictives dans le navigateur (aucun appel réseau).
# Par défaut : actif si VITE_API_URL est vide.
VITE_DEMO_MODE=
